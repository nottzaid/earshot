#!/usr/bin/env python3
"""Earshot PC daemon.

Runs the ROC receiver that turns the phone's stream into a PipeWire mic, answers
discovery probes, and keeps a control channel with the paired phone: who is
listening, mute, default-mic and latency mode.

Usage: earshotd [run]       run the daemon (default)
       earshotd unpair      forget the paired phone
       earshotd status      print the paired phone and receiver settings
"""

import asyncio
import collections
import hashlib
import hmac
import json
import os
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

PROTO_VERSION = 2
CONTROL_PORT = 10004
DISCOVERY_PORT = 10005
DISCOVERY_PROBE = b"EARSHOT?2"
MAX_LINE = 16 * 1024
NODE_NAME = "earshot.mic"
NODE_DESCRIPTION = "Earshot"

# Receiver-side half of each latency mode; the phone owns the packet/FEC half.
LATENCY_MS = {"tight": 30, "balanced": 50, "steady": 100}
DEFAULT_MODE = "balanced"

# Graceful fallback when the phone vanishes: keep the default mic for a moment
# so a Wi-Fi blip doesn't bounce every app to another mic and back.
DEFAULT_REVERT_GRACE_S = 4.0

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "earshot"
STATE_FILE = STATE_DIR / "state.json"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "earshot"

# The receiver: ROC decoding with Earshot's own steady clock matching (see earshot-rx.c).
RECEIVER_BIN = Path(__file__).resolve().parent / "earshot-rx"


def log(*args):
    print(*args, file=sys.stderr, flush=True)


# ---------------------------------------------------------------- persisted state

def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2))
    tmp.chmod(0o600)
    tmp.replace(STATE_FILE)


# ---------------------------------------------------------------- pactl helpers

async def pactl(*args):
    proc = await asyncio.create_subprocess_exec(
        "pactl", *args, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
    out, _ = await proc.communicate()
    return out.decode() if proc.returncode == 0 else None


async def pactl_json(*args):
    out = await pactl("-f", "json", *args)
    try:
        return json.loads(out) if out else None
    except ValueError:
        return None


def is_real_listener(output):
    """A source-output that is an app actually recording, not a level meter."""
    p = output.get("properties", {})
    if output.get("corked"):
        return False
    if p.get("stream.monitor") == "true" or p.get("node.passive") == "true":
        return False
    if p.get("media.name", "").lower() in ("peak detect", "peak detection"):
        return False
    return True


def app_label(output):
    p = output.get("properties", {})
    return (p.get("application.name") or p.get("application.process.binary")
            or p.get("node.name") or "An app")


# ---------------------------------------------------------------- receiver

class Receiver:
    """Owns the earshot-rx child that hosts the phone's source node."""

    def __init__(self, on_change):
        self.latency = LATENCY_MS[DEFAULT_MODE]
        self.echo = False
        self.proc = None
        self.status = "down"
        self._on_change = on_change
        self._task = None
        self._restart = asyncio.Event()

    def start(self, latency, echo):
        self.latency = latency
        self.echo = echo
        self._task = asyncio.create_task(self._supervise())

    def set_echo(self, on):
        # Applied live: the receiver keeps running and only starts or stops cancelling.
        self.echo = on
        if self.proc and self.proc.returncode is None and self.proc.stdin:
            try:
                self.proc.stdin.write(b"aec on\n" if on else b"aec off\n")
            except (BrokenPipeError, ConnectionResetError):
                pass

    def set_latency(self, latency):
        if latency != self.latency:
            self.latency = latency
            self._restart.set()

    async def _supervise(self):
        backoff = 0.5
        while True:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
            started = time.monotonic()
            try:
                self.proc = await asyncio.create_subprocess_exec(
                    str(RECEIVER_BIN), "--latency", str(self.latency), "--node", NODE_NAME,
                    "--description", NODE_DESCRIPTION, "--clock", str(STATE_DIR / "clock"),
                    "--stats", str(RUNTIME_DIR / "rx.stats"),
                    "--aec", "on" if self.echo else "off", "--control",
                    stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.DEVNULL,
                    stderr=asyncio.subprocess.PIPE)
            except OSError as e:
                log(f"receiver: can't start {RECEIVER_BIN} ({e}); build it with `make -C pc`")
                await asyncio.sleep(10)
                continue
            self._set_status("up")
            log(f"receiver: started (target latency {self.latency} ms)")
            tail = collections.deque(maxlen=20)
            drain = asyncio.create_task(self._drain(self.proc.stderr, tail))
            exited = asyncio.create_task(self.proc.wait())
            restart = asyncio.create_task(self._restart.wait())
            done, _ = await asyncio.wait({exited, restart}, return_when=asyncio.FIRST_COMPLETED)
            if restart in done:
                self._restart.clear()
                await self._terminate()
                drain.cancel()
                backoff = 0.5
                continue
            restart.cancel()
            await drain
            log(f"receiver: exited with {self.proc.returncode}: {' | '.join(tail)[-500:]}")
            self._set_status("down")
            if time.monotonic() - started > 10:
                backoff = 0.5
            await asyncio.sleep(backoff)
            backoff = min(backoff * 2, 10)

    @staticmethod
    async def _drain(stream, tail):
        # Read stderr as it comes so the child never blocks on a full pipe.
        async for line in stream:
            tail.append(line.decode(errors="replace").strip())

    async def _terminate(self):
        if self.proc and self.proc.returncode is None:
            self.proc.terminate()
            try:
                await asyncio.wait_for(self.proc.wait(), 3)
            except asyncio.TimeoutError:
                self.proc.kill()
                await self.proc.wait()

    def _set_status(self, status):
        if status != self.status:
            self.status = status
            self._on_change()

    async def stop(self):
        if self._task:
            self._task.cancel()
        await self._terminate()


# ---------------------------------------------------------------- daemon

def proof(secret, role, first, second):
    """HMAC that shows the sender knows the pairing secret, bound to both nonces."""
    msg = f"earshot/{PROTO_VERSION}/{role}/{first}/{second}".encode()
    return hmac.new(bytes.fromhex(secret), msg, hashlib.sha256).hexdigest()


class Daemon:
    def __init__(self):
        self.state = load_state()
        if "pc_id" not in self.state:
            self.update_state(pc_id=secrets.token_hex(8))
        self.mode = self.state.get("mode", DEFAULT_MODE)
        if self.mode not in LATENCY_MS:
            self.mode = DEFAULT_MODE
        self.echo = bool(self.state.get("echo", False))  # remove this PC's speakers from the mic
        # The daemon owns mute: it survives receiver restarts and is re-applied to a new node.
        self.want_muted = bool(self.state.get("muted", False))
        self.mute_seq = 0                # last phone mute request applied (per connection)
        self.receiver = Receiver(self.schedule_refresh)
        self.client = None               # the connected, authenticated phone's writer
        self.client_prefs = {}
        self.pc = {"listening": False, "apps": [], "default": False, "node": False}
        self.node_index = None
        self._lock = asyncio.Lock()      # refreshes and our own pactl changes never interleave
        self._dirty = False
        self._refresh_task = None
        self._revert_task = None
        self.hostname = socket.gethostname()

    def update_state(self, **changes):
        self.state = {**load_state(), **changes}
        save_state(self.state)

    def paired(self):
        return load_state().get("paired")  # re-read: `earshotd unpair` edits the file

    # -- PipeWire observation

    def schedule_refresh(self):
        self._dirty = True
        if self._refresh_task is None or self._refresh_task.done():
            self._refresh_task = asyncio.create_task(self._refresh_loop())

    async def _refresh_loop(self):
        await asyncio.sleep(0.05)  # coalesce bursts of events
        while self._dirty:
            self._dirty = False
            await self.refresh()

    async def refresh(self):
        mute_changed = False
        async with self._lock:
            sources = await pactl_json("list", "sources")
            if sources is None:
                return  # pipewire-pulse unreachable: keep the last known state
            ours = next((s for s in sources if s.get("name") == NODE_NAME), None)
            default = (await pactl("get-default-source") or "").strip()
            apps = []
            if ours is not None:
                if ours["index"] != self.node_index:
                    # A new node (daemon start or receiver restart): give it our mute and default.
                    self.node_index = ours["index"]
                    await self._apply_mute()
                    if self.client and self.client_prefs.get("default"):
                        await self._set_default(True)
                        default = NODE_NAME
                elif bool(ours.get("mute")) != self.want_muted:
                    # Same node, mute changed by someone on the PC: follow it and tell the phone.
                    self.want_muted = bool(ours.get("mute"))
                    self.update_state(muted=self.want_muted)
                    mute_changed = True
                outputs = await pactl_json("list", "source-outputs") or []
                apps = sorted({app_label(o) for o in outputs
                               if o.get("source") == ours["index"] and is_real_listener(o)})
            else:
                self.node_index = None
            pc = {"listening": bool(apps), "apps": apps, "default": default == NODE_NAME,
                  "node": ours is not None}
            changed = pc != self.pc or mute_changed
            self.pc = pc
        if changed:
            await self.push_state()

    async def _apply_mute(self):
        await pactl("set-source-mute", NODE_NAME, "1" if self.want_muted else "0")

    async def watch_pipewire(self):
        while True:
            proc = await asyncio.create_subprocess_exec(
                "pactl", "subscribe", stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.DEVNULL)
            self.schedule_refresh()
            async for line in proc.stdout:
                text = line.decode(errors="replace")
                if "source" in text or "server" in text:
                    self.schedule_refresh()
            await proc.wait()
            await asyncio.sleep(1)

    # -- control channel

    def state_message(self):
        return {"t": "state", "receiver": self.receiver.status, "mode": self.mode, "echo": self.echo,
                "muted": self.want_muted, "mute_seq": self.mute_seq, **self.pc}

    async def push_state(self):
        if self.client:
            await self.send(self.client, self.state_message())

    async def send(self, writer, msg):
        try:
            writer.write((json.dumps(msg) + "\n").encode())
            await writer.drain()
        except (ConnectionError, OSError):
            pass

    async def handle_client(self, reader, writer):
        peer = writer.get_extra_info("peername")
        sock = writer.get_extra_info("socket")
        if sock is not None:
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        device_id = None
        try:
            hello = await asyncio.wait_for(self._read(reader), 10)
            if not hello or hello.get("t") != "hello":
                return
            device_id = await self._handshake(hello, reader, writer)
            if not device_id:
                return
            log(f"control: {str(hello.get('name', '?'))[:64]} connected from {peer[0]}")
            if self.client:  # the same phone reconnecting: newest connection wins
                self.client.close()
            self.client = writer
            self.mute_seq = 0
            self._cancel_revert()
            prefs = hello.get("prefs")
            await self.apply_prefs(prefs if isinstance(prefs, dict) else {})
            self.schedule_refresh()
            await self.send(writer, self.state_message())
            while True:
                msg = await asyncio.wait_for(self._read(reader), 30)
                if msg is None:
                    break
                paired = self.paired()
                if not paired or paired["id"] != device_id:
                    log("control: pairing revoked, dropping the phone")
                    await self.send(writer, {"t": "denied", "reason": "not-paired"})
                    break
                if not await self.on_message(writer, msg):
                    break
        except (asyncio.TimeoutError, ConnectionError, OSError, ValueError):
            pass  # ValueError: a line over the reader's limit
        finally:
            if device_id and self.client is writer:
                self.client = None
                log("control: phone disconnected")
                self._schedule_revert()
            writer.close()

    async def _read(self, reader):
        line = await reader.readline()
        if not line:
            return None
        try:
            msg = json.loads(line)
        except ValueError:
            raise ConnectionError("bad json")
        return msg if isinstance(msg, dict) else None

    async def _handshake(self, hello, reader, writer):
        """Pair (on the phone user's explicit request) or prove both sides know the secret.

        Returns the phone's id once trusted, else None. The secret crosses the network
        only once, at pairing; afterwards each side proves knowledge with an HMAC.
        """
        device_id = str(hello.get("id", ""))[:64]
        name = str(hello.get("name", "Phone"))[:64]
        phone_nonce = str(hello.get("nonce", ""))[:64]
        if hello.get("v") != PROTO_VERSION or not device_id or len(phone_nonce) < 16:
            await self.send(writer, {"t": "denied", "reason": "version"})
            return None
        paired = self.paired()
        pc_id = self.state["pc_id"]

        if hello.get("pair"):
            if paired is not None:
                await self.send(writer, {"t": "denied", "reason": "paired-elsewhere"})
                return None
            paired = {"id": device_id, "name": name, "secret": secrets.token_hex(32)}
            self.update_state(paired=paired)
            log(f"pairing: paired with {name}")
            notify(f"Paired with {name}", "It can now use this PC as its microphone. "
                   "Run `earshotd unpair` to forget it.")
            await self.send(writer, {"t": "paired", "pc": pc_id, "host": self.hostname,
                                     "secret": paired["secret"]})
            return device_id

        if paired is None or paired["id"] != device_id:
            await self.send(writer, {"t": "denied", "reason": "not-paired"})
            return None
        pc_nonce = secrets.token_hex(16)
        await self.send(writer, {"t": "challenge", "pc": pc_id, "host": self.hostname, "nonce": pc_nonce,
                                 "proof": proof(paired["secret"], "pc", phone_nonce, pc_nonce)})
        answer = await asyncio.wait_for(self._read(reader), 10)
        expected = proof(paired["secret"], "phone", pc_nonce, phone_nonce)
        if not answer or answer.get("t") != "auth" or not hmac.compare_digest(
                str(answer.get("proof", "")), expected):
            await self.send(writer, {"t": "denied", "reason": "bad-proof"})
            return None
        await self.send(writer, {"t": "welcome", "v": PROTO_VERSION, "host": self.hostname})
        return device_id

    async def on_message(self, writer, msg):
        """Handles one message; False ends the session."""
        kind = msg.get("t")
        if kind == "ping":
            await self.send(writer, {"t": "pong", "n": msg.get("n")})
        elif kind == "set":
            if "muted" in msg:
                async with self._lock:
                    self.want_muted = bool(msg["muted"])
                    seq = msg.get("seq")
                    self.mute_seq = seq if isinstance(seq, int) else self.mute_seq
                    self.update_state(muted=self.want_muted)
                    if self.node_index is not None:
                        await self._apply_mute()
                await self.push_state()
            await self.apply_prefs(msg)
            self.schedule_refresh()
        elif kind == "unpair":
            self.update_state(paired=None)
            log("pairing: the phone unpaired itself")
            await self.send(writer, {"t": "unpaired"})
            return False
        return True

    async def apply_prefs(self, prefs):
        if "default" in prefs:
            self.client_prefs["default"] = bool(prefs["default"])
            async with self._lock:
                await self._set_default(self.client_prefs["default"])
        mode = prefs.get("mode")
        if mode in LATENCY_MS and mode != self.mode:
            self.mode = mode
            self.update_state(mode=mode)
            self.receiver.set_latency(LATENCY_MS[mode])
            await self.push_state()
        if "echo" in prefs and bool(prefs["echo"]) != self.echo:
            self.echo = bool(prefs["echo"])
            self.update_state(echo=self.echo)
            self.receiver.set_echo(self.echo)
            log(f"echo cancellation {'on' if self.echo else 'off'}")
            await self.push_state()

    async def _set_default(self, want):
        if self.node_index is None:
            return  # no node yet; refresh() applies it when the node appears
        current = (await pactl("get-default-source") or "").strip()
        if want and current != NODE_NAME:
            if current:
                self.update_state(previous_default=current)
            await pactl("set-default-source", NODE_NAME)
        elif not want and current == NODE_NAME:
            previous = load_state().get("previous_default")
            if previous:
                await pactl("set-default-source", previous)

    def _schedule_revert(self):
        if self.client_prefs.get("default"):
            self._cancel_revert()
            self._revert_task = asyncio.create_task(self._revert_later())

    def _cancel_revert(self):
        if self._revert_task:
            self._revert_task.cancel()
            self._revert_task = None

    async def _revert_later(self):
        await asyncio.sleep(DEFAULT_REVERT_GRACE_S)
        if self.client is None:
            async with self._lock:
                await self._set_default(False)
            self.schedule_refresh()

    # -- discovery

    class Discovery(asyncio.DatagramProtocol):
        def __init__(self, daemon):
            self.daemon = daemon

        def connection_made(self, transport):
            self.transport = transport

        def datagram_received(self, data, addr):
            if data.strip() == DISCOVERY_PROBE:
                reply = {"t": "here", "v": PROTO_VERSION, "host": self.daemon.hostname,
                         "pc": self.daemon.state["pc_id"], "port": CONTROL_PORT,
                         "pairable": self.daemon.paired() is None}
                self.transport.sendto(json.dumps(reply).encode(), addr)

    # -- lifecycle

    async def run(self):
        loop = asyncio.get_running_loop()
        stop = asyncio.Event()
        for sig in (signal.SIGINT, signal.SIGTERM):
            loop.add_signal_handler(sig, stop.set)

        self.receiver.start(LATENCY_MS[self.mode], self.echo)
        server = await asyncio.start_server(self.handle_client, "0.0.0.0", CONTROL_PORT,
                                            limit=MAX_LINE)
        await loop.create_datagram_endpoint(
            lambda: self.Discovery(self), local_addr=("0.0.0.0", DISCOVERY_PORT),
            allow_broadcast=True)
        watcher = asyncio.create_task(self.watch_pipewire())
        log(f"earshotd: control on :{CONTROL_PORT}, discovery on :{DISCOVERY_PORT}/udp")

        await stop.wait()
        watcher.cancel()
        server.close()
        if self.client_prefs.get("default"):
            async with self._lock:
                await self._set_default(False)
        await self.receiver.stop()


def notify(title, body):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "Earshot", "-i", "phone", title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    if cmd == "run":
        asyncio.run(Daemon().run())
    elif cmd == "unpair":
        state = load_state()
        name = (state.pop("paired", None) or {}).get("name")
        save_state(state)
        print(f"Forgot {name}." if name else "No phone was paired.")
    elif cmd == "status":
        state = load_state()
        paired = state.get("paired")
        print(f"paired: {paired['name'] if paired else 'none'}")
        print(f"mode: {state.get('mode', DEFAULT_MODE)}")
        print(f"echo cancellation: {'on' if state.get('echo') else 'off'}")
    else:
        print(__doc__.strip())
        sys.exit(2)


if __name__ == "__main__":
    main()
